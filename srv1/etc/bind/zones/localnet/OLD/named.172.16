$TTL 86400	; 1 day
@       IN SOA  @ suporte (
                        1          ; serial
                        15m        ; refresh
                        5m         ; retry
                        1D         ; expire
                        15m        ; minimum
                )
        NS                      @
        TXT                     "ZonaLocal"
        A                       127.0.0.1

$ORIGIN 16.172.in-addr.arpa.
1.0                   PTR     srv1.B.localnet.
2.0                   PTR     srv2.B.localnet.
