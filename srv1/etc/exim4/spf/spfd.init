#! /bin/sh
### BEGIN INIT INFO
# Provides:          spfd
# Required-Start:    $remote_fs $syslog $named $network $time
# Required-Stop:     $remote_fs $syslog $named $network
# Should-Start:      exim4
# Should-Stop:       exim4
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: spfd Mail SPF check
# Description:       spfd Mail SPF check
### END INIT INFO

# apt-get install lib*-perl

set -e

#if [ -f /usr/sbin/spfd.mail-spf-perl ]; then
#    DAEMON=/usr/sbin/spfd.mail-spf-perl
#fi
DAEMON=/etc/exim4/spf/spfd

NAME=`basename $DAEMON`
PIDFILE=/var/run/$NAME.pid
SOCKFILE=/var/run/$NAME/$NAME
GRPNAME=mail
USRNAME=Debian-exim

# Check the package is still installed
[ -x $DAEMON ] || exit 0

# Get LSB functions
. /lib/lsb/init-functions
. /etc/default/rcS

case "$1" in
    start)
	log_daemon_msg "Starting Mail Source CHeck" "$NAME"
	    if [ -f $PIDFILE ]; then
		kill `cat $PIDFILE`
	    fi
	    killall  --user $USRNAME $NAME 2> /dev/null >/dev/null &
	    mkdir -p `dirname $SOCKFILE`
	    $DAEMON --socket=$SOCKFILE --socket-user $USRNAME --socket-group $GRPNAME --set-user $USRNAME --set-group $GRPNAME 2> /dev/null >/dev/null &
	    RETVAL=$?
	    PID=$!
	    echo $PID > $PIDFILE
	    log_end_msg $RETVAL 
	;;
    stop)
	log_daemon_msg "Stop Mail Source CHeck" "$NAME"
	    killall  --user $USRNAME $NAME 2> /dev/null >/dev/null &
	    RETVAL=$?
	    rm -f $PIDFILE
	    log_end_msg $RETVAL 
	;;
    #install)
    #	update-rc.d -f `basename $0` remove  > /dev/null # 2> /dev/null
    #	update-rc.d `basename $0` start 90 2 3 4 5 . stop 80 0 1 6 . > /dev/null # 2> /dev/null
    #	;;
    restart|reload|force-reload)
	$0 stop
	$0 start
	;;
*)
	#echo "Usage: /etc/init.d/spfd {start|stop|restart|reload|force-reload}"
	#exit 1
	;;
esac

exit 0
