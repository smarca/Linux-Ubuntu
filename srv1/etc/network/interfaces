# The loopback network interface
no-auto-down lo
auto lo
iface lo inet loopback
	post-up if [ -z "`cat /etc/iproute2/rt_tables | grep eth0`" ]; then echo "100 eth0" >> /etc/iproute2/rt_tables; fi
	post-up if [ -z "`cat /etc/iproute2/rt_tables | grep eth1`" ]; then echo "101 eth1" >> /etc/iproute2/rt_tables; fi
	post-up if [ -z "`cat /etc/iproute2/rt_tables | grep eth2`" ]; then echo "102 eth2" >> /etc/iproute2/rt_tables; fi
        post-up echo 1 > /proc/sys/net/ipv6/conf/all/disable_ipv6
        post-up echo 0 > /proc/sys/net/ipv6/conf/lo/disable_ipv6

# The primary network interface
auto eth0
        iface eth0 inet6 auto
	iface eth0 inet static 
	address 10.0.0.1 
	network 10.0.0.0
	netmask 255.0.0.0
	broadcast 10.255.255.255 
	post-up route add -net 239.0.0.0 netmask 255.0.0.0 eth0
	post-up route add -net 224.0.0.0 netmask 255.0.0.0 eth0
	post-up if [ -z "`cat /etc/iproute2/rt_tables | grep eth0`" ]; then echo "100 eth0" >> /etc/iproute2/rt_tables; fi
        post-up   ip route add default via 10.0.0.2 dev eth0 table eth0
	post-up	  ip route add 10.0.0.0/8 dev eth0 src 10.0.0.1 table eth0 
	post-up   ip rule add to 10.0.0.0/8 table eth0 prio 1
	pre-down  ip rule del to 10.0.0.0/8
	# post-up ip rule add from 10.0.0.2 table eth0 prio 1
	post-up   ip route add 172.16.2.0/24 via 10.0.0.2 dev eth0 
        post-up echo 1 > /proc/sys/net/ipv6/conf/eth0/disable_ipv6
	post-up   ip route flush cache

# The secondary network interface
no-auto-down eth1
allow-hotplug eth1
auto eth1
        iface eth1 inet6 auto
	iface eth1 inet static 
	address 177.220.156.178
	netmask 255.255.255.248
	# gateway 177.220.156.177
	# metric 200
	post-up if [ -z "`cat /etc/iproute2/rt_tables | grep eth1`" ]; then echo "101 eth1" >> /etc/iproute2/rt_tables; fi
        post-up   ip route add default via 177.220.156.177 dev eth1 table eth1 
	post-up   ip route add default via 177.220.156.177 dev eth1 metric 200
	post-up	  ip route add 177.220.156.176/29 dev eth1 src 177.220.156.178 table eth1 
        # post-up ip rule add from 177.220.156.178 table eth1 prio 1
	post-up   ip rule add from 177.220.156.176/29 table eth1 prio 30000
	pre-down  ip rule del from 177.220.156.176/29 
        post-up   ip rule add to 177.220.156.176/29 table eth1 prio 1
        pre-down  ip rule del to 177.220.156.176/29
	post-up	  ip rule add fwmark 1 table eth1  prio 20000
	pre-down  ip rule del fwmark 1 
	post-up	  ip rule add fwmark 2 table eth1  prio 20000
	pre-down  ip rule del fwmark 2 
	post-up	  ip rule add fwmark 5 table eth1  prio 20000
	pre-down  ip rule del fwmark 5 
	post-up	  ip rule add fwmark 10 table eth1 prio 20000
	pre-down  ip rule del fwmark 10 
        post-up echo 1 > /proc/sys/net/ipv6/conf/eth1/disable_ipv6
	post-up   ip route flush cache

allow-hotplug eth2
auto eth2
        iface eth2 inet6 auto
#       iface eth2 inet dhcp
        iface eth2 inet static
        address 192.168.1.251
        netmask 255.255.255.0
        # gateway 192.168.1.1
        # metric 100
        post-up if [ -z "`cat /etc/iproute2/rt_tables | grep eth2`" ]; then echo "102 eth2" >> /etc/iproute2/rt_tables; fi
        post-up   ip route add default via 192.168.1.1 dev eth2 table eth2 
	post-up   ip route add default via 192.168.1.1 dev eth2 metric 100 
        post-up   ip route add 192.168.1.0/24 dev eth2 src 192.168.1.251 table eth2  
        post-up   ip rule add to 192.168.1.0/24 table eth2 prio 1
        pre-down  ip rule del to 192.168.1.0/24
        #post-up   ip route add default nexthop via 192.168.1.1 dev eth2 weight 1 nexthop via 177.220.156.177 dev eth1 weight 1
        #post-down ip route del default nexthop via 192.168.1.1 dev eth2 weight 1 nexthop via 177.220.156.177 dev eth1 weight 1
	# post-up ip rule add from 192.168.1.252 table eth2 prio 1
        post-up echo 1 > /proc/sys/net/ipv6/conf/eth2/disable_ipv6
        post-up   ip route flush cache










