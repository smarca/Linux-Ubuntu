service poppassd
{
        disable = no
        socket_type     = stream
        wait            = no
        user            = root
        instances       = 50
        per_source      = 50
        cps             = 10 60
        access_times    = 00:05-23:55
        #server         = /etc/exim4/poppass/virdomadm
        server          = /usr/sbin/virdomadm
        server_args     = dbbd=maildb dbuser=virtualmailmgr dbpass=marcaisowner
        #server_args    = nodb=yes
        flags           = NOLIBWRAP NORETRY NODELAY
        nice            = 10
        only_from       = 127.0.0.1
        bind            = 127.0.0.1
        log_on_success  += HOST DURATION
        log_on_failure  += HOST ATTEMPT USERID
        port            = 106
}

