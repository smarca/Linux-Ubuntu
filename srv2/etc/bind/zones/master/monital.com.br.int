;###########################################################################
@ 	IN SOA intsrv2 suporte.metropol.com.br. (
	        2017112900 ; serial
		30M ; refresh
		15M ; retry
		12H ; expire
		2H  ; Negative Cache TTL
	)
			IN	A	10.0.0.2
			IN	A	10.0.0.1
			IN      NS      intsrv1
			IN      NS      intsrv2
			IN	MX	0	intsrv2
			IN	TXT	"v=spf1 mx a:intsrv1.metropol.com.br a:intsrv2.metropol.com.br include:_spf.smtplw.com -all"
			IN 	SPF 	"v=spf1 mx a:intsrv1.metropol.com.br a:intsrv2.metropol.com.br include:_spf.smtplw.com -all"
			IN	RP	Marca. suporte.metropol.com.br.
$ORIGIN @

;----------------------------------------------------------------------------
;# Servidores Principais
$TTL    5M
intsrv                  IN      A       10.0.0.2
                        IN      A       10.0.0.1

intsrv1                 IN      A       10.0.0.1
                        IN      MX      0       intsrv1

intsrv2                 IN      A       10.0.0.2
                        IN      MX      0       intsrv2
;----------------------------------------------------------------------------
$TTL    3H
srv                     IN      A       177.220.156.178
                        IN      A       177.220.156.179
vip                     IN      A       177.220.156.180
;                       IN      A       177.220.156.178
;                       IN      A       177.220.156.179
cam                     IN      A       177.220.156.181
voip                    IN      A       177.220.156.182

srv1                    IN      A       177.220.156.178
                        IN      MX      0       srv1

srv2                    IN      A       177.220.156.179
                        IN      MX      0       srv2

sti                     IN      A       138.122.152.227

;----------------------------------------------------------------------------
; host -t SRV _smtp._tcp.servidor.com.br
$TTL    1H
mail                    IN      CNAME   intsrv2
smtp                    IN      CNAME   intsrv2
imap                    IN      CNAME   intsrv2
pop                     IN      CNAME   intsrv2
pop3                    IN      CNAME   intsrv2

;----------------------------------------------------------------------------
$TTL    1H
_autodiscover._tcp      IN      SRV     0               0               443             intsrv2
_autodiscover._tcp      IN      SRV     1               0               80              intsrv2
autoconfig              IN      CNAME   intsrv2
autodiscover            IN      CNAME   intsrv2

;----------------------------------------------------------------------------
;# Maquinas apelido pra servidor principal
$TTL    3H
www                     IN      CNAME   monital.hospedagemdesites.ws.
home                    IN      CNAME   @
;boleto                 IN      CNAME   @
;cliente                IN      CNAME   @
;clientes               IN      CNAME   @
;----------------------------------------------------------------------------
; smtp locaweb : smtplw.com.br : Porta: 587 | SSL/TLS: 465
smtplw                  IN      TXT     ebd932b4f43011ee3e6ae205c402300a
envios                  IN      CNAME   smtplw.com.
;----------------------------------------------------------------------------
$TTL    3H
vm			IN	NS	ns1.no-ip.com.
			IN	NS	ns2.no-ip.com.
			IN	NS	ns3.no-ip.com.
			IN	NS	ns4.no-ip.com.
			IN	NS	ns5.no-ip.com.

ntp                     IN      CNAME   intsrv2
;painel                 IN      CNAME   intsrv2
webmail                 IN      CNAME   intsrv2
webmail2                IN      CNAME   intsrv1
$TTL    1H
;mkt                    IN      CNAME   intsrv2
dvr                     IN      CNAME   intsrv2
ddns                    IN      CNAME   intsrv2
stat1                   IN      CNAME   intsrv1
stat2                   IN      CNAME   intsrv2
traf1                   IN      CNAME   intsrv1
traf2                   IN      CNAME   intsrv2

;----------------------------------------------------------------------------
;Configurar Modem Externamente
$TTL    5M
mdm1-srv1               IN      CNAME   intsrv1
mdm2-srv1               IN      CNAME   intsrv1
mdm3-srv1               IN      CNAME   intsrv1
mdm1-srv2               IN      CNAME   intsrv2
mdm2-srv2               IN      CNAME   intsrv2
mdm3-srv2               IN      CNAME   intsrv2

;----------------------------------------------------------------------------
_domainkey 14400 IN       TXT     "o=~; r=suporte@monital.com.br"
cur._domainkey 14400 IN       TXT     "dk2017112900"
