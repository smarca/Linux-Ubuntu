@ 	IN SOA srv2 suporte.metropol.com.br. (
		2017040603 ; serial
		1H  ; refresh
		15M ; retry
		7D  ; expire
		1H  ; Negative Cache TTL
	)
			IN	A	177.220.156.179
		 	IN	A	177.220.156.178
			IN      NS      srv1
			IN      NS      srv2
                        IN      TXT     "v=spf1 include:_spf.google.com -all"
                        IN      SPF     "v=spf1 include:_spf.google.com -all"
			IN	RP	Marca. suporte.metropol.com.br.
                3600    IN      MX      1       ASPMX.L.GOOGLE.COM.
                3600    IN      MX      5       ALT1.ASPMX.L.GOOGLE.COM.
                3600    IN      MX      5       ALT2.ASPMX.L.GOOGLE.COM.
                3600    IN      MX      10      ALT3.ASPMX.L.GOOGLE.COM.
                3600    IN      MX      10      ALT4.ASPMX.L.GOOGLE.COM.
$ORIGIN @

;----------------------------------------------------------------------------
;# Servidores Principais
$TTL	4H
srv1			IN	A	177.220.156.178
			IN	MX	0	srv1
			IN	TXT	"v=spf1 mx a:srv1.metropol.com.br a:srv2.metropol.com.br -all"
			IN 	SPF 	"v=spf1 mx a:srv1.metropol.com.br a:srv2.metropol.com.br -all"
			IN	RP	Marca. suporte.metropol.com.br.

$TTL	18H
srv2			IN	A	177.220.156.179
			IN	MX	0	srv2
			IN	TXT	"v=spf1 mx a:srv1.metropol.com.br a:srv2.metropol.com.br -all"
			IN 	SPF 	"v=spf1 mx a:srv1.metropol.com.br a:srv2.metropol.com.br -all"
			IN	RP	Marca. suporte.metropol.com.br.

$TTL	2H
srv                     IN      A       177.220.156.178
			IN      A       177.220.156.179

sti                     IN      A       138.122.159.227
;----------------------------------------------------------------------------
;# GOOGLE cname
$TTL	12H
kbb7cxxva4nr		IN	CNAME	gv-xl4kybpzpcpnlg.dv.googlehosted.com.

;----------------------------------------------------------------------------
;# Maquinas apelido pra servidor principal
$TTL	1H
www			IN	CNAME	monital.camerite.com.
home                    IN      CNAME   @
;boleto                 IN      CNAME   @
;cliente                IN      CNAME   @
;clientes               IN      CNAME   @
;----------------------------------------------------------------------------
$TTL    3H
ntp                     IN      CNAME   srv2
ssh1                    IN      CNAME   srv1
ssh2                    IN      CNAME   srv2
ssl1                    IN      CNAME   srv1
ssl2                    IN      CNAME   srv2
;painel                 IN      CNAME   srv2
webmail                 IN      CNAME   srv2
webmail2                IN      CNAME   srv1

$TTL    1H
stat1                   IN      CNAME   srv1
stat2                   IN      CNAME   srv2
traf1                   IN      CNAME   srv1
traf2                   IN      CNAME   srv2
;mkt                    IN      CNAME   srv2
dvr                     IN      CNAME   srv2
cam                     IN      CNAME   srv2
ddns                    IN      CNAME   srv2

;----------------------------------------------------------------------------
; host -t SRV _smtp._tcp.servidor.com.br
$TTL	1H
;Service.Proto.Name     IN  	SRV 	Pri(<maior) 	Weight(>maior)	Port 		Target
_smtp._tcp              IN  	SRV 	0 		0 		25  		srv2
_ssmtp._tcp             IN      SRV     0               0               465             srv2
_submission.tcp		IN  	SRV 	0 		0 		587 		srv2
_imap._tcp              IN  	SRV 	0 		0 		143 		srv2
_imaps._tcp             IN  	SRV 	0 		0 		993 		srv2
_pop3._tcp              IN  	SRV 	0 		0 		110 		srv2
_pop3s._tcp             IN  	SRV 	0 		0 		995 		srv2
mail                    IN      CNAME   srv2
smtp                    IN      CNAME   srv2
imap			IN	CNAME   srv2
pop			IN	CNAME   srv2
pop3			IN	CNAME   srv2

;----------------------------------------------------------------------------
$TTL    1H
_autodiscover._tcp      IN      SRV     0               0               443             srv2
_autodiscover._tcp      IN      SRV	1               0               80              srv2
autoconfig              IN      CNAME   srv2
autodiscover            IN      CNAME   srv2

;----------------------------------------------------------------------------
;Configurar Modem Externamente
$TTL    5M
mdm1-srv1		IN	CNAME	srv1
mdm2-srv1		IN	CNAME	srv1
mdm3-srv1		IN	CNAME	srv1
mdm1-srv2		IN	CNAME	srv2
mdm2-srv2		IN	CNAME	srv2
mdm3-srv2		IN	CNAME	srv2

