# ln -s firewall_min /etc/rc.d/rc3.d/s98firewallmin
DEV_EXT="eth0"		       #Interface Externa
KEYNAMED="/var/named/etc/Krealonline.ddns.grupogsn.com.br.+157+40132.key"
#INT="eth1"		       #Interface Interna
#BAND="120kbit"                 #Maximo banda - 10%
#IPSQUID="192.168.0.1"	       #IP SQUID

#ZERAR
/usr/sbin/iptables -F -t filter
/usr/sbin/iptables -F -t nat

#REDIR SQUID
#/usr/sbin/iptables -t nat -A PREROUTING  -i $INT -p tcp -m multiport --dports "www,81:89" -m state --state,ESTABLISHED,RELATED -j DNAT --to $IPSQUID:3128
#MASQ REDE INT
#/usr/sbin/iptables -t nat -A POSTROUTING -o $EXT -j MASQUERADE

#TCP ACESSOS
SSHPORT="`cat /etc/ssh/sshd_config | grep -E "^Port " | cut -f2 -d" "`"
/usr/sbin/iptables -t filter -A INPUT   -i $DEV_EXT -p tcp -m multiport --dports "$SSHPORT,www,https,domain,ftp,ftp-data,smtp,pop-3,auth" -m state --state NEW,ESTABLISHED,RELATED -j ACCEPT
/usr/sbin/iptables -t filter -A INPUT   -i $DEV_EXT -p tcp -m multiport --sports "$SSHPORT,www,https,domain,ftp,ftp-data,smtp,pop-3,auth" -m state --state     ESTABLISHED,RELATED -j ACCEPT
/usr/sbin/iptables -t filter -A OUTPUT  -o $DEV_EXT -p tcp -m multiport --sports "$SSHPORT,www,https,domain,ftp,ftp-data,smtp,pop-3,auth" -m state --state     ESTABLISHED,RELATED -j ACCEPT
/usr/sbin/iptables -t filter -A OUTPUT  -o $DEV_EXT -p tcp -m multiport --dports "$SSHPORT,www,https,domain,ftp,ftp-data,smtp,pop-3,auth" -m state --state NEW,ESTABLISHED,RELATED -j ACCEPT
/usr/sbin/iptables -t filter -A FORWARD -i $DEV_EXT -p tcp -m multiport --dports "$SSHPORT,www,https,domain,ftp,ftp-data,smtp,pop-3,auth" -m state --state     ESTABLISHED,RELATED -j ACCEPT
/usr/sbin/iptables -t filter -A FORWARD -o $DEV_EXT -p tcp -m multiport --dports "$SSHPORT,www,https,domain,ftp,ftp-data,smtp,pop-3,auth" -m state --state NEW,ESTABLISHED,RELATED -j ACCEPT

#UDP ACESSOS
/usr/sbin/iptables -t filter -A INPUT   -i $DEV_EXT -p udp -m multiport --dports "domain,ntp" -m state --state NEW,ESTABLISHED,RELATED -j ACCEPT
/usr/sbin/iptables -t filter -A INPUT   -i $DEV_EXT -p udp -m multiport --sports "domain,ntp" -m state --state     ESTABLISHED,RELATED -j ACCEPT
/usr/sbin/iptables -t filter -A OUTPUT  -o $DEV_EXT -p udp -m multiport --sports "domain,ntp" -m state --state     ESTABLISHED,RELATED -j ACCEPT
/usr/sbin/iptables -t filter -A OUTPUT  -o $DEV_EXT -p udp -m multiport --dports "domain,ntp" -m state --state NEW,ESTABLISHED,RELATED -j ACCEPT
/usr/sbin/iptables -t filter -A FORWARD -i $DEV_EXT -p udp -m multiport --sports "domain,ntp" -m state --state     ESTABLISHED,RELATED -j ACCEPT
/usr/sbin/iptables -t filter -A FORWARD -o $DEV_EXT -p udp -m multiport --dports "domain,ntp" -m state --state NEW,ESTABLISHED,RELATED -j ACCEPT

#ICMP ACESSOS
/usr/sbin/iptables -t filter -A INPUT   -i $DEV_EXT -p icmp -m state --state NEW,ESTABLISHED,RELATED -j ACCEPT
/usr/sbin/iptables -t filter -A OUTPUT  -o $DEV_EXT -p icmp -m state --state NEW,ESTABLISHED,RELATED -j ACCEPT
/usr/sbin/iptables -t filter -A FORWARD -i $DEV_EXT -p icmp -m state --state     ESTABLISHED,RELATED -j ACCEPT
/usr/sbin/iptables -t filter -A FORWARD -o $DEV_EXT -p icmp -m state --state NEW,ESTABLISHED,RELATED -j ACCEPT

#RELATED PORTS (FTP e Outros)
HIGHPORTS="1024:65535"
/usr/sbin/iptables -t filter -A INPUT   -i $DEV_EXT -p tcp --sport $HIGHPORTS --dport $HIGHPORTS -m state --state ESTABLISHED,RELATED -j ACCEPT
/usr/sbin/iptables -t filter -A FORWARD -o $DEV_EXT -p tcp --sport $HIGHPORTS --dport $HIGHPORTS -m state --state ESTABLISHED,RELATED -j ACCEPT
/usr/sbin/iptables -t filter -A OUTPUT  -o $DEV_EXT -p tcp --dport $HIGHPORTS --sport $HIGHPORTS -m state --state ESTABLISHED,RELATED -j ACCEPT
/usr/sbin/iptables -t filter -A INPUT   -i $DEV_EXT -p udp --sport $HIGHPORTS --dport $HIGHPORTS -m state --state ESTABLISHED,RELATED -j ACCEPT
/usr/sbin/iptables -t filter -A FORWARD -o $DEV_EXT -p udp --sport $HIGHPORTS --dport $HIGHPORTS -m state --state ESTABLISHED,RELATED -j ACCEPT
/usr/sbin/iptables -t filter -A OUTPUT  -o $DEV_EXT -p udp --dport $HIGHPORTS --sport $HIGHPORTS -m state --state ESTABLISHED,RELATED -j ACCEPT

#HOST ADM GSN
HSTGSN="`host grupogsn.com.br | grep address | cut -f4 -d' ' | head -1`"
if [ "$HSTGSN" != "" ]; then
   /usr/sbin/iptables -t filter -A INPUT  -s "$HSTGSN" -j ACCEPT
   /usr/sbin/iptables -t filter -A OUTPUT -d "$HSTGSN" -j ACCEPT
fi

#BLOQUEIO TOTAL PARA REDE DEV_EXTERNA
/usr/sbin/iptables -t filter -A INPUT   -i $DEV_EXT -j LOG --log-prefix "Packetlog: INPUT "
/usr/sbin/iptables -t filter -A INPUT   -i $DEV_EXT -j DROP
/usr/sbin/iptables -t filter -A FORWARD -o $DEV_EXT -j LOG --log-prefix "Packetlog: FORWARD "
/usr/sbin/iptables -t filter -A FORWARD -o $DEV_EXT -j DROP
/usr/sbin/iptables -t filter -A OUTPUT  -o $DEV_EXT -j LOG --log-prefix "Packetlog: OUTPUT "
/usr/sbin/iptables -t filter -A OUTPUT  -o $DEV_EXT -j DROP
/usr/sbin/iptables -t filter -A FORWARD -i $DEV_EXT -j LOG --log-prefix "Packetlog: FORWARD "
/usr/sbin/iptables -t filter -A FORWARD -i $DEV_EXT -j DROP

#ModProb
   /sbin/modprobe -s -a ip_conntrack*
   /sbin/modprobe -s -a ip_nat*
   /sbin/modprobe -s -a arptable_filter
   ## Logar pacotes impossiveis
   for i in /proc/sys/net/ipv4/conf/*/log_martians; do echo "1" > $i; done
   ## Desabilitar Squid ADVANCED (Problemas em abrir paginas)
   echo "0" > /proc/sys/net/ipv4/tcp_ecn
   ## Discartar pacotes já roteados por aqui
   for i in /proc/sys/net/ipv4/conf/*/accept_source_route; do echo "0" > $i; done
   ## Filtrar rotas estranhas (1 pra habliltar filtragem), 0 para VPN
   for i in /proc/sys/net/ipv4/conf/*/rp_filter; do echo "1" > $i; done
   ## Desabilitar aceite de redirecionamentos
   for i in /proc/sys/net/ipv4/conf/*/accept_redirects; do echo "0" > $i; done
   ## Ignorar mensagens estranhas
   echo "1" > /proc/sys/net/ipv4/icmp_ignore_bogus_error_responses
   ## Sync Cookies Protecao
   echo "1" > /proc/sys/net/ipv4/tcp_syncookies
   ## Ignorar ping no broadcast
   echo "1" > /proc/sys/net/ipv4/icmp_echo_ignore_broadcasts
   ## Ignorar pings
   #echo "1" > /proc/sys/net/ipv4/icmp_echo_ignore_all
   ## Desabilitar envio de redirecionamentos
   #for i in /proc/sys/net/ipv4/conf/*/send_redirects; do echo "0" > $i; done

#QOS SFQ
#/sbin/tc qdisc del dev $DEV_EXT root 2> /dev/null 
#/sbin/tc qdisc add dev $DEV_EXT root  handle 99:00 tbf rate $BAND latency 50ms burst 1540
. /etc/rc.d/init.d/functions
function DDNS {
if [ "$KEYNAMED" != "" ]; then
  HOSTNAME="$(hostname | cut -d. -f1)"
  gprintf "Atualizando DDNS ddns.grupogsn.com.br ($HOSTNAME)..." && {
    LOOP=0
    while [ "`ifconfig | grep $DEV_EXT`" == "" -a "$LOOP" -lt 60 ]; do
        LOOP=$[$LOOP+1]
        sleep $[$LOOP*10]
    done
    IP="`ip addr | grep -e "global $DEV_EXT$" |  awk '{ print $2 }' | cut -f1 -d "/" | head -1`"
    SERVER="ns1.grupogsn.com.br"
    ZONE="ddns.grupogsn.com.br"
    TTL="60"
    TXT="`date +%d/%m/%Y-%T-%Z`"
    RESULT=`nsupdate -v -k $KEYNAMED << EOF
            server $SERVER
            zone $ZONE
            update delete $HOSTNAME A
            update add $HOSTNAME $TTL A $IP
            update delete $HOSTNAME MX
            update add $HOSTNAME $TTL MX 1 $HOSTNAME
            update delete $HOSTNAME TXT
            update add $HOSTNAME $TTL TXT $TXT
            send
        `
    logger -t DDNS $HOSTNAME $IP Atualizado!
  } &&  echo_success; echo
 fi
}

DDNS